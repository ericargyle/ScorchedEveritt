{
  "name": "scorched-everitt",
  "version": "1.0.0",
  "description": "Modern recreation of the UIUC ECE291 artillery game",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "ScorchedEveritt contributors",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "test": "node --test",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "^1.58.0"
  },
  "build": {
    "appId": "io.github.ericargyle.scorchedeveritt",
    "productName": "ScorchedEveritt",
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "ScorchedEveritt-Windows-11-x64.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}